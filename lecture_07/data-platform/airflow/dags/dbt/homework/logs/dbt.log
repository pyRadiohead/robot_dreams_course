            else 0
        end as is_species__versicolor,

    

        case
            when species = 'virginica' then 1
            else 0
        end as is_species__virginica,

    

    case
        when species is null then 1
        else 0
    end as is_species__


from "analytics"."homework"."stg_iris"
  );
  
