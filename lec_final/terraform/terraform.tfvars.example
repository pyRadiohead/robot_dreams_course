# Copy this file to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to version control!

project_name = "yurii-data-platform"
aws_region   = "us-east-1"

# Redshift credentials
redshift_master_username = "admin"
redshift_master_password = "YourRedshiftPass1!"  # Change this!

# Airflow credentials
airflow_admin_username = "admin"
airflow_admin_password = "YourAirflowPass1!"  # Change this!

# Cost optimization settings (these are already the defaults)
# redshift_base_capacity      = 8       # Minimum RPUs
# airflow_cpu                 = 512     # Minimum for Fargate
# airflow_memory              = 1024    # Minimum for 512 CPU
# airflow_db_instance_class   = "db.t3.micro"  # Free-tier eligible
# airflow_db_allocated_storage = 20     # GB
# log_retention_days          = 7       # Reduced from 14 to save costs

